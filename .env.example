# --- Database (Supabase Postgres) ---
# Pooler transaksi (port 6543) untuk aplikasi/Prisma Client.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Koneksi langsung/session pooler (port 5432) untuk prisma db push / migrate.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# WAJIB diganti di produksi. Minimal 32 karakter acak.
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- Aplikasi ---
APP_NAME="KostManager"
APP_URL="http://localhost:3000"

# --- Supabase Storage (bukti bayar, bucket privat) ---
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-server-only"
SUPABASE_STORAGE_BUCKET="payment-proofs"

# --- Kanal notifikasi (opsional, kosongkan untuk mode simulasi) ---
WA_PROVIDER_TOKEN=""
WA_SENDER_NUMBER=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# --- Akun owner pertama (dipakai `npm run db:owner`) ---
OWNER_NAME="Owner Kost"
OWNER_EMAIL="owner@domain-anda.com"
OWNER_PASSWORD="ganti-password-kuat-min-8-huruf-angka"
