// Skema database KostManager
// Database produksi: PostgreSQL (Supabase).
// DATABASE_URL memakai connection pooler Supabase (port 6543).
// DIRECT_URL memakai koneksi langsung (port 5432) untuk migrasi/db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  phone        String?
  role         String         @default("admin") // owner | admin | staff | tenant
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  lastLoginAt  DateTime?
  tenantId     String?        @unique
  tenant       Tenant?        @relation("TenantUser", fields: [tenantId], references: [id], onDelete: SetNull)
  properties   UserProperty[]
  payments     Payment[]      @relation("PaymentVerifier")
  meterReadings MeterReading[] @relation("MeterVerifier")
  invoiceWaivers Invoice[]    @relation("InvoiceWaiver")
  auditLogs    AuditLog[]
}

model UserProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Property {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  address   String
  city      String
  notes     String?
  electricityTariff    Int     @default(1500)
  requireMeterReading  Boolean @default(true)
  requireTenantProfile Boolean @default(false)
  createdAt DateTime       @default(now())
  rooms     Room[]
  users     UserProperty[]
  paymentChannels PaymentChannel[]
}

model Room {
  id           String        @id @default(cuid())
  propertyId   String
  number       String
  floor        Int           @default(1)
  type         String?
  monthlyPrice Int
  status       String        @default("kosong") // kosong | terisi | booked | perbaikan | nonaktif
  facilities   String? // JSON string array
  meterSerial  String?
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contracts    Contract[]
  maintenance  Maintenance[]
  meterReadings MeterReading[]

  @@unique([propertyId, number])
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  phone            String
  email            String?
  idNumber         String?
  emergencyContact String?
  addressOrigin    String?
  status           String            @default("aktif") // aktif | nonaktif
  createdAt        DateTime          @default(now())
  contracts        Contract[]
  maintenance      Maintenance[]
  notifications    NotificationLog[]
  meterReadings    MeterReading[]
  user             User?             @relation("TenantUser")
}

model Contract {
  id               String    @id @default(cuid())
  tenantId         String
  roomId           String
  startDate        DateTime
  endDate          DateTime
  rentAmount       Int
  deposit          Int       @default(0)
  billingDay       Int       @default(1)
  status           String    @default("active") // active | ended | cancelled
  endedAt          DateTime?
  depositReturned  Int?
  depositDeduction Int?
  electricityStartReading Float?
  notes            String?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  room             Room      @relation(fields: [roomId], references: [id])
  invoices         Invoice[]
  meterReadings    MeterReading[]
}

model Invoice {
  id              String            @id @default(cuid())
  contractId      String
  invoiceNo       String            @unique
  periodStart     DateTime
  periodEnd       DateTime
  issueDate       DateTime          @default(now())
  dueDate         DateTime
  subtotal        Int
  additionalTotal Int               @default(0)
  total           Int
  paidTotal       Int               @default(0)
  status          String            @default("draft") // draft | unpaid | paid | overdue | void
  voidReason      String?
  source          String            @default("auto") // auto | manual
  publishedAt     DateTime?
  requirementsWaivedReason String?
  requirementsWaivedById   String?
  createdAt       DateTime          @default(now())
  contract        Contract          @relation(fields: [contractId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  notifications   NotificationLog[]
  meterReadings   MeterReading[]
  requirementsWaivedBy User?       @relation("InvoiceWaiver", fields: [requirementsWaivedById], references: [id])

  @@unique([contractId, periodStart])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  type        String  @default("rent") // rent | utility | penalty | other
  amount      Int
  meterReadingId String? @unique
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  meterReading MeterReading? @relation(fields: [meterReadingId], references: [id])
}

model Payment {
  id              String    @id @default(cuid())
  invoiceId       String
  channelId       String?
  method          String    @default("transfer") // cash | transfer | qris | gateway
  amount          Int
  paidAt          DateTime
  proofUrl        String?
  status          String    @default("pending") // pending | verified | rejected
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  channel         PaymentChannel? @relation(fields: [channelId], references: [id])
  verifiedBy      User?     @relation("PaymentVerifier", fields: [verifiedById], references: [id])
}

model PaymentChannel {
  id            String    @id @default(cuid())
  propertyId    String
  type          String    @default("bank") // bank | qris | cash
  label         String
  bankName      String?
  accountNumber String?
  accountHolder String?
  qrisUrl       String?
  instructions  String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([propertyId, isActive])
}

model MeterReading {
  id              String    @id @default(cuid())
  roomId          String
  contractId      String?
  tenantId        String?
  periodStart     DateTime
  periodEnd       DateTime
  readingAt       DateTime  @default(now())
  previousReading Float
  currentReading  Float
  usageKwh        Float
  tariffPerKwh    Int
  amount          Int
  photoUrl        String?
  source          String    @default("tenant") // tenant | staff | admin
  status          String    @default("pending") // pending | verified | rejected | billed
  isBaseline      Boolean   @default(false)
  notes           String?
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  invoiceId       String?
  billedAt        DateTime?
  createdAt       DateTime  @default(now())
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  contract        Contract? @relation(fields: [contractId], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  verifiedBy      User?     @relation("MeterVerifier", fields: [verifiedById], references: [id])
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  invoiceItem     InvoiceItem?

  @@index([roomId, readingAt])
  @@index([status])
  @@index([contractId, periodStart])
}

model Maintenance {
  id          String    @id @default(cuid())
  roomId      String
  tenantId    String?
  title       String
  description String
  category    String    @default("umum")
  priority    String    @default("sedang") // rendah | sedang | tinggi
  photos      String? // JSON string array
  status      String    @default("baru") // baru | diproses | selesai | ditutup
  cost        Int       @default(0)
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  closedAt    DateTime?
  room        Room      @relation(fields: [roomId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([status, priority])
}

model NotificationLog {
  id           String    @id @default(cuid())
  invoiceId    String?
  tenantId     String?
  channel      String // whatsapp | email
  templateKey  String
  payload      String?
  status       String    @default("queued") // queued | sent | failed
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id])
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
